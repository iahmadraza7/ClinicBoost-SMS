# Nightly Postgres backup for ClinicBoost SMS.
# Install on the server (adjust the user if not root):
#
#   sudo cp deploy/clinicboost-backup.cron /etc/cron.d/clinicboost-backup
#   sudo chmod 644 /etc/cron.d/clinicboost-backup
#
# Or append to crontab -e:
#   0 3 * * * cd /opt/clinicboost && ./scripts/backup-db.sh >> /var/log/clinicboost-backup.log 2>&1
#
# Backups land in /opt/clinicboost/backups/. Seven days are kept.
# Copy the newest file off the server regularly (see docs/BACKUP_AND_RESTORE.md).

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

0 3 * * * root cd /opt/clinicboost && ./scripts/backup-db.sh >> /var/log/clinicboost-backup.log 2>&1
