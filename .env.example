# Copy to .env.local for dev, .env for the server. Never commit either.

NODE_ENV=development
APP_URL=http://localhost:3000
# production: https://reply.clinicboost.com.au

# In .env.local (host processes: npm run dev, npm run db:migrate) the host is
# localhost. In .env (read by docker compose, and by the containers) it is `db`,
# the compose service name.
DATABASE_URL=postgresql://clinicboost:changeme@localhost:5432/clinicboost
POSTGRES_USER=clinicboost
POSTGRES_PASSWORD=changeme
POSTGRES_DB=clinicboost

# Single operator login
AUTH_SECRET=
OPERATOR_EMAIL=
OPERATOR_PASSWORD_HASH=

# Anthropic. Client's key. Set a monthly spend cap in their console.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Mobile Message
# console writes replies to the log and sends nothing. Credentials alone never
# spend credits: switch to mobile_message when you are ready to send for real.
SMS_PROVIDER=console
MOBILE_MESSAGE_API_USER=
MOBILE_MESSAGE_API_PASSWORD=
# Settings > API > Webhook Signing Secret. The webhooks refuse to run without
# it, because they are public endpoints that write to the database.
MOBILE_MESSAGE_WEBHOOK_SECRET=
# Shared test number while testing, per-clinic dedicated numbers later
MOBILE_MESSAGE_TEST_SENDER=+61485900170
# The test number is shared, so inbound cannot be routed by number yet. This
# says which clinic owns traffic on a number no clinic claims. Once each clinic
# has its own number, set clinics.sms_number and clear this.
SHARED_NUMBER_CLINIC_SLUG=beauty-soiree

# Resend. Sending only, receiving disabled.
# Notifications must contain clinic name and a dashboard link ONLY.
RESEND_API_KEY=
RESEND_FROM=notify@notify.clinicboost.com.au
OPERATOR_NOTIFY_EMAIL=
OPERATOR_NOTIFY_MOBILE=

# Safety rails
GLOBAL_KILL_SWITCH=false
MAX_SEGMENTS_PER_DRAFT=3
